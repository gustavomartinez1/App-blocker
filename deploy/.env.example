# Dominio que apunta a la IP del servidor (registro A). Caddy saca el certificado HTTPS solo.
DOMAIN=guardian.midominio.com

# Genera uno con: openssl rand -hex 32
GUARDIAN_TOKEN_SECRET=

GUARDIAN_PUBLIC_URL=https://guardian.midominio.com
GUARDIAN_VAPID_SUBJECT=mailto:tu-correo@midominio.com

# Opcional: bot de Telegram (créalo con @BotFather y pega el token)
GUARDIAN_TELEGRAM_BOT_TOKEN=

# Opcional: correo (Brevo, Resend, Zoho, Gmail con contraseña de aplicación…)
# GUARDIAN_SMTP_URL=smtps://usuario:clave@smtp-relay.brevo.com:465
GUARDIAN_SMTP_FROM=Guardián <alertas@midominio.com>
